+    fn shuffles_keep_the_reconstructed_name_order_of_the_remaining_library() {
+        let runtime = runtime();
+        let ordered = [
+            vec!["Beta".to_owned(); 7],
+            vec!["Alpha".to_owned(), "Beta".to_owned(), "Alpha".to_owned()],
+            vec!["Beta".to_owned(); 12],
+            vec!["Alpha".to_owned(); 18],
